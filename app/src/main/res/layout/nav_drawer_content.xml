<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0F"
    android:orientation="vertical"
    android:paddingTop="48dp"
    android:paddingHorizontal="20dp"
    android:paddingBottom="24dp">

    <!-- Top Drawer Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MYRA"
            android:textColor="#FF1744"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:fontFamily="sans-serif-black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_prime_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="PRO AI"
            android:textColor="#D500F9"
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Section 1: Persona & Voice Selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PERSONA &amp; VOICE"
                android:textColor="#FF1744"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_widget_card"
                android:padding="14dp"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Voice Gender / Model Style"
                    android:textColor="#CCCCCC"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/drawerSpinnerVoiceGender"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_input_field"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/drawerPitchLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Voice Pitch: 1.0x"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />

                <SeekBar
                    android:id="@+id/drawerSeekPitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="10"
                    android:progress="5"
                    android:progressTint="#FF1744"
                    android:thumbTint="#FF1744"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/drawerSpeedLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Speaking Speed: 1.0x"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />

                <SeekBar
                    android:id="@+id/drawerSeekSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="10"
                    android:progress="5"
                    android:progressTint="#D500F9"
                    android:thumbTint="#D500F9" />
            </LinearLayout>

            <!-- Section 2: Preferred Music Platform -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PREFERRED MUSIC PLATFORM"
                android:textColor="#FF1744"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/drawerRadioMusicPlatform"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_widget_card"
                android:padding="12dp"
                android:layout_marginBottom="16dp">

                <RadioButton
                    android:id="@+id/radioYouTube"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YouTube"
                    android:textColor="#FFFFFF"
                    android:buttonTint="#FF0000"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/radioSpotify"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Spotify"
                    android:textColor="#FFFFFF"
                    android:buttonTint="#1ED760" />

                <RadioButton
                    android:id="@+id/radioYtMusic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YouTube Music"
                    android:textColor="#FFFFFF"
                    android:buttonTint="#FF1744" />
            </RadioGroup>

            <!-- Section 3: Navigation Shortcuts -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYSTEM &amp; SETTINGS"
                android:textColor="#FF1744"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_widget_card"
                android:orientation="vertical"
                android:padding="6dp"
                android:layout_marginBottom="16dp">

                <!-- Memories Shortcut -->
                <LinearLayout
                    android:id="@+id/drawerItemMemories"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_memory"
                        android:tint="#D500F9" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:text="Persistent Memories &amp; Vault"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Settings Shortcut -->
                <LinearLayout
                    android:id="@+id/drawerItemSettings"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_settings"
                        android:tint="#FF1744" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:text="Assistant Settings &amp; Skills"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Permissions Setup Shortcut -->
                <LinearLayout
                    android:id="@+id/drawerItemPermissions"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_shield"
                        android:tint="#00E676" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:text="Permissions &amp; Automation"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Floating Overlay Toggle -->
                <LinearLayout
                    android:id="@+id/drawerItemOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_scan"
                        android:tint="#40C4FF" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:text="Floating Screen Orb"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Emergency SOS Trigger Shortcut -->
                <LinearLayout
                    android:id="@+id/drawerItemSos"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="22dp"
                        android:layout_height="wrap_content"
                        android:text="🚨"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:text="Offline Panic SOS Guard"
                        android:textColor="#FF1744"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Focus & Zen Mode Shortcut -->
                <LinearLayout
                    android:id="@+id/drawerItemFocus"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="22dp"
                        android:layout_height="wrap_content"
                        android:text="🧘"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:text="Focus &amp; Zen Mode Companion"
                        android:textColor="#00E5FF"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Wake Word Switch in Drawer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_widget_card"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Voice Wake Word ('Hey MYRA')"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Awakens MYRA in the background"
                        android:textColor="#777777"
                        android:textSize="11sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/drawerSwitchWakeWord"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:thumbTint="#FF1744"
                    app:trackTint="#66FF1744" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
