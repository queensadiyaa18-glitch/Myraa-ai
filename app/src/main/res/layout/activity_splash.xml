<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505">

    <!-- Subtle Ambient Cyberpunk Glow -->
    <View
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_orb_glow"
        android:alpha="0.25" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="24dp">

        <!-- Centered Sleek Loading Animation / Pulsing Gradient Orb -->
        <FrameLayout
            android:id="@+id/splashOrbContainer"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_marginBottom="32dp">

            <!-- Pulsing Custom Orb View -->
            <com.myra.assistant.ui.main.OrbAnimationView
                android:id="@+id/splashOrbView"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center" />
        </FrameLayout>

        <!-- Brand Element 1: App Name prominently at the center -->
        <TextView
            android:id="@+id/splashAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MYRA"
            android:textColor="#FF1744"
            android:textSize="36sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.28" />

        <!-- Brand Element 2: Tagline directly below the name -->
        <TextView
            android:id="@+id/splashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Your AI Assistant, Redefined"
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1" />

        <!-- AI Initializing Status Indicator -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ProgressBar
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:indeterminateTint="#D500F9"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/splashStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Initializing Neural Core..."
                android:textColor="#888888"
                android:textSize="12sp"
                android:fontFamily="monospace" />
        </LinearLayout>
    </LinearLayout>

    <!-- Version Footer -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:text="VERSION 2.0 • PRO EDITION"
        android:textColor="#444444"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.15" />
</FrameLayout>
