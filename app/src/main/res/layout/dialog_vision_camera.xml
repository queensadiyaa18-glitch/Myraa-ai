<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#141419"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AI VISION LENS &amp; MULTIMODAL OCR"
            android:textColor="#FF1744"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black" />

        <ImageButton
            android:id="@+id/visionCloseBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:contentDescription="Close Camera" />
    </LinearLayout>

    <!-- Camera Preview Frame -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="230dp"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="#000000"
        app:cardElevation="4dp"
        android:layout_marginBottom="12dp">

        <androidx.camera.view.PreviewView
            android:id="@+id/cameraPreviewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.cardview.widget.CardView>

    <!-- Quick Multimodal Vision Triggers Row 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnAnalyzeScene"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="🔍 Scene &amp; Object"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:background="@drawable/bg_save_button"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnExtractOcr"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="📄 Doc &amp; OCR"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:background="@drawable/bg_prime_badge"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Quick Multimodal Vision Triggers Row 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="10dp">

        <Button
            android:id="@+id/btnIdentifyPlantMed"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="🌿 Plant &amp; Medicine"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:background="@drawable/bg_prime_badge"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnBiometricStress"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="💓 Stress &amp; Fatigue"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:background="@drawable/bg_save_button"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/textVisionResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Aim camera at objects, medicines, face, or documents to analyze"
        android:textColor="#CCCCCC"
        android:textSize="12sp"
        android:fontFamily="sans-serif"
        android:padding="10dp"
        android:background="#0C0C10" />
</LinearLayout>
