<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#101010">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- Icon Badge -->
        <TextView
            android:id="@+id/textPermIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎤"
            android:textSize="20sp"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textPermTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Record Audio"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textPermDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Voice recognition &amp; conversation with MYRA"
                android:textColor="#888888"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Status Tag / Action Button -->
        <TextView
            android:id="@+id/badgeStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_status"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="GRANTED ✅"
            android:textColor="#00E676"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
